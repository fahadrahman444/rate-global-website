# Rate Global — Production Environment Configuration Example
# Copy to .env.local for local overrides or .env.production on production servers

# Base Canonical URL
NEXT_PUBLIC_SITE_URL=https://rateglobal.com

# Inbound Lead Inquiry Target Email (Optional for future SMTP or Webhook integration)
CONTACT_NOTIFICATION_EMAIL=inquiry@rateglobal.com

# Server Port
PORT=3000
